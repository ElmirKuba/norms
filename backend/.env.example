# App
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://norms:norms@localhost:5432/norms

# Redis (BullMQ, rate-limit, reset_token TTL)
REDIS_URL=redis://localhost:6379

# Auth (see docs/auth-devices.md)
JWT_ACCESS_TTL=15s
JWT_REFRESH_TTL=30d
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Devices
DEVICE_LIMIT=20

# Invites
INVITE_TTL_DAYS=7

# Feature flags (see docs/invites.md)
FEATURE_FREE_REGISTRATION=false
FEATURE_DEV_MODE=false
