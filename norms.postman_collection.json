{
  "info": {
    "_postman_id": "2ba8426a-0375-48b0-a91d-8be475860ea9",
    "name": "norms",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Флоу 0 — Система",
      "item": [
        {
          "name": "Фича-флаги",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/app/feature-flags" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Флоу 1 — Регистрация и UIN",
      "item": [
        {
          "name": "1. Проверить инвайт",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"1234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/invite/check" }
          },
          "response": []
        },
        {
          "name": "2. Зарегистрироваться",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', res.session.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.session.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"secret123\",\n  \"system_name\": \"MacBook Pro\",\n  \"platform\": \"electron\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/create" }
          },
          "response": []
        },
        {
          "name": "3. UIN-статус",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/uin/read-status" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Флоу 2 — Авторизация",
      "item": [
        {
          "name": "4. Логин по UIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', res.session.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.session.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"12345\",\n  \"password\": \"secret123\",\n  \"system_name\": \"iPhone 15\",\n  \"platform\": \"ios\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/auth" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Флоу 3 — Токены и сессия",
      "item": [
        {
          "name": "6. Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', res.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/session/refresh" }
          },
          "response": []
        },
        {
          "name": "8. Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/logout" }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Флоу 4 — Приглашения",
      "item": [
        {
          "name": "1. Создать код приглашения",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/invite/create" }
          },
          "response": []
        },
        {
          "name": "2. Список инвайтов",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/invite/read-list" }
          },
          "response": []
        },
        {
          "name": "3. Проверить инвайт",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"1234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/invite/check" }
          },
          "response": []
        },
        {
          "name": "4. Зарегистрироваться по инвайту",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', res.session.access_token);",
                  "  pm.collectionVariables.set('refresh_token', res.session.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"secret123\",\n  \"invite_code\": \"1234567890\",\n  \"system_name\": \"Test Device\",\n  \"platform\": \"electron\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/account/create" }
          },
          "response": []
        },
        {
          "name": "5. Реферальная информация",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/invite/read-referrals" }
          },
          "response": []
        },
        {
          "name": "6. Отозвать инвайт",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/invite/revoke/:id", "variable": [{ "key": "id", "value": "" }] }
          },
          "response": []
        }
      ]
    }
  ]
}
